
const express = require("express");
const { instrument } = require("../shared/metrics");

const app = express();

app.use(express.json());

// Register Prometheus metrics
instrument(app, "modular_monolith", "monolith");

// Product module
const product = {
    get: (id) => ({
        id,
        name: "Brewora House Coffee",
        price: 250
    })
};

// Catalog module
const catalog = {
    search: (query) => {
        const items = [
            {
                id: "coffee-1",
                name: "Brewora House Coffee",
                price: 250
            }
        ];

        return items.filter(item =>
            item.name.toLowerCase().includes(query.toLowerCase())
        );
    }
};

// Inventory module
const inventory = {
    stock: 100,

    reserve(quantity) {
        if (this.stock < quantity) {
            return false;
        }

        this.stock -= quantity;
        return true;
    },

    adjust(amount) {
        this.stock += amount;
        return this.stock;
    }
};

// Payment module
const payment = {
    charge: () => ({
        status: "paid",
        transactionId: "pay-" + Date.now()
    })
};

// Kitchen module
const kitchen = {
    accept: () => ({
        status: "accepted"
    })
};

// Notification module
const notification = {
    send: () => ({
        status: "queued"
    })
};

// Order module
const order = {
    create(body) {
        const quantity = Math.max(
            1,
            Number(body.quantity) || 1
        );

        if (!inventory.reserve(quantity)) {
            return {
                status: 409,
                body: {
                    error: "Insufficient inventory"
                }
            };
        }

        return {
            status: 201,
            body: {
                orderId: "ord-" + Date.now(),
                productId: body.productId || "coffee-1",
                quantity,
                payment: payment.charge(),
                kitchen: kitchen.accept(),
                notification: notification.send(),
                orderStatus: "confirmed"
            }
        };
    }
};

// Health check
app.get("/health", (_req, res) => {
    res.json({
        status: "ok",
        architecture: "modular-monolith"
    });
});

// Get product
app.get("/api/products/:id", (req, res) => {
    res.json(product.get(req.params.id));
});

// Search catalog
app.get("/api/catalog/search", (req, res) => {
    const query = String(req.query.q || "");

    res.json({
        items: catalog.search(query)
    });
});

// Check inventory
app.get("/api/inventory/:id", (_req, res) => {
    res.json({
        stock: inventory.stock
    });
});

// Adjust inventory
app.post("/api/inventory/adjust", (req, res) => {
    const amount = Number(req.body.amount) || 0;

    res.json({
        stock: inventory.adjust(amount)
    });
});

// Create order
app.post("/api/orders", (req, res) => {
    const result = order.create(req.body || {});

    res.status(result.status).json(result.body);
});

// Start server
const PORT = Number(process.env.PORT) || 5100;

app.listen(PORT, () => {
    console.log(`Modular Monolith: http://localhost:${PORT}`);
    console.log(`Prometheus metrics: http://localhost:${PORT}/metrics`);
});
